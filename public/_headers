# Headers para controle de cache

# version.json nunca deve ser cacheado
/version.json
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

# index.html nunca deve ser cacheado
/index.html
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache

# Assets estáticos podem ser cacheados (hash no nome)
/*.js
  Cache-Control: public, max-age=31536000, immutable

/*.css
  Cache-Control: public, max-age=31536000, immutable

# Service Worker deve ser verificado sempre
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate
